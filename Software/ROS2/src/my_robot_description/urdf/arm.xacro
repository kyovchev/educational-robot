    <child link="link1"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

